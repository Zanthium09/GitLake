# Copy to .env and fill in. .env is gitignored.
# Only week-1 variables are listed; Kafka and Snowflake settings get added
# when those legs are built, so this file never documents config that
# nothing reads yet.

# --- AWS / S3 -----------------------------------------------------------
# IAM user needs s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket
# on the bucket below. DeleteObject is required: Delta rewrites and removes
# files during commits, and a read/write-only policy fails mid-transaction.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bucket name only, no s3:// prefix and no trailing slash.
S3_BUCKET=

# --- GitHub Archive -----------------------------------------------------
# Target window is 2024-01-15..2024-01-21. Start with the single day and
# scale to the week only once the pipeline runs end to end.
GHARCHIVE_DATE=2024-01-15
