# Astro loads this into every Airflow container automatically. Not the same
# file as the gitlake repo root .env (that one holds secrets and is mounted
# read-only into the scheduler separately).
#
# JWT expiration bumped to 1 hour: stream_ingest legitimately runs 10-15
# minutes (producing 5.5M events into Kafka), and Airflow 3's default task
# execution API token lifetime is shorter than that. The task's own work was
# fine -- it failed reporting its state back to the API server mid-run with
# "403 Invalid auth token", not from any actual error in the subprocess.
# Both config keys are set since it was not obvious from `airflow config
# list` alone which one governs the token used by a running task talking
# back to the API server.
AIRFLOW__API_AUTH__JWT_EXPIRATION_TIME=3600
AIRFLOW__EXECUTION_API__JWT_EXPIRATION_TIME=3600
